#!/bin/sh
# .husky/_ is generated by "husky install" and is not checked in, so a fresh
# clone or worktree can reach this hook before it exists.
husky_sh="$(dirname "$0")/_/husky.sh"
if [ -f "$husky_sh" ]; then
  . "$husky_sh"
else
  echo "husky - $husky_sh missing, run 'npm install' to reinstall the git hooks"
fi

npx lint-staged

{
  "name": "cerebra",
  "version": "0.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sonar": "sonar-scanner",
    "lint": "ng lint",
    "prepare": "husky install || true",
    "json-server": "concurrently \"node ./server/json-server-funktion.mjs\" \"ng serve\"",
    "cerebra-mock-backend": "concurrently \"node ./server/json-server-funktion.mjs\" \"ng serve --configuration development,rosmock\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.6",
    "admin-lte": "^3.2.0-rc",
    "angular-split": "^20.0.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "deep-chat": "^2.5.0",
    "font-awesome": "^4.7.0",
    "json-server": "^0.17.4",
    "marked": "^18.0.0",
    "ngx-highlightjs": "^14.0.1",
    "ngx-markdown": "^22.0.0",
    "roslib": "^2.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.7",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "~22.0.7",
    "@angular/compiler-cli": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@types/jasmine": "~5.1.0",
    "@types/json-server": "^0.14.7",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.0",
    "@types/webrtc": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "angular-eslint": "^22.1.0",
    "blockly": "^10.2.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.12.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "katex": "^0.18.1",
    "lint-staged": "^13.2.3",
    "marked-katex-extension": "^5.1.10",
    "prettier": "3.0.0",
    "schematics-scss-migrate": "^2.3.17",
    "sonar-scanner": "^3.1.0",
    "stylelint-config-prettier": "^9.0.5",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{js,html,css,scss,ts}": "prettier --write ."
  },
  "overrides": {
    "summernote": {
      "husky": "9.1.7"
    },
    "marked-katex-extension": {
      "katex": "$katex"
    },
    "ngx-markdown": {
      "katex": "$katex"
    }
  }
}
